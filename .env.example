# Hotelads — Variables de entorno
# Copiar como .env en el servidor: httpdocs/.env (un nivel por encima de httpdocs/dist/).
# NUNCA subir el .env real al repositorio (ver .gitignore).

# Google Gemini (AI) — usado por public/asistente/chat-server.php
GOOGLE_API_KEY=

# WhatsApp Cloud API — WABA de Hotelads, usada por send-whatsapp.php para
# enviar la plantilla "info_hotel" en nombre de cualquier chatbot de la red
WA_ACCESS_TOKEN=

# Token compartido con hotelesarrecife.es (y otros chatbots de la red Hotelads)
# para autenticar la llamada server-to-server a send-whatsapp.php
# (MISMO valor que INTERNAL_API_TOKEN_HOTELADS en el .env de hotelesarrecife)
INTERNAL_API_TOKEN=
