# Rate Shopper - acceso restringido (herramienta interna, uso facturable vía SerpApi)
#
# Corta la herencia del rewrite de public/.htaccess (regla que reescribe cualquier
# directorio a $1/index.html sin comprobar si existe). Esta carpeta sirve index.php,
# no index.html, así que sin esto /rateshopper/ cae al 404 del sitio. Con "RewriteRule ^ - [L]"
# se detiene aquí la cadena de rewrite heredada y el DirectoryIndex global de Apache
# (que ya incluye index.php) resuelve la carpeta normalmente.
<IfModule mod_rewrite.c>
  RewriteEngine On
  # El .htaccess padre tiene DirectorySlash Off, así que hay que forzar
  # la barra final explícitamente para esta carpeta antes de cortar el
  # rewrite heredado, o /rateshopper (sin barra) devuelve 403 en vez de
  # servir index.php.
  RewriteCond %{REQUEST_URI} ^/rateshopper$
  RewriteRule ^ %{REQUEST_URI}/ [R=301,L]
  RewriteRule ^ - [L]
</IfModule>

# AuthUserFile: ruta absoluta confirmada en producción (hotelads.es, Plesk).
# El .htpasswd NO vive dentro de esta carpeta (dist/rateshopper/): esa carpeta la
# regenera `npm run build` en cada deploy y se perdería. Vive en rateshopper-config/,
# un directorio HERMANO de dist/ (mismo sitio que config.php, ver includes/config-loader.php),
# que sobrevive a cualquier rebuild. No es un secreto (es una ruta de filesystem del
# servidor), por eso queda hardcodeada aquí en vez de como placeholder.

AuthType Basic
AuthName "Rate Shopper - Acceso restringido"
AuthUserFile /var/www/vhosts/hotelads.es/httpdocs/rateshopper-config/.htpasswd
Require valid-user

# Refuerzo: deniega el acceso directo a archivos sensibles si alguno acabara
# aquí por error (config.php/.htpasswd ya no viven en esta carpeta, pero por si acaso).
<FilesMatch "^(config\.php|config\.example\.php|\.htpasswd|\.htaccess)$">
    Require all denied
</FilesMatch>

<FilesMatch "\.sql$">
    Require all denied
</FilesMatch>
