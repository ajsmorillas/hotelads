AddDefaultCharset UTF-8
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

ErrorDocument 404 /404.html

# ── Agent discovery (RFC 8288) ───────────────────────────────
<IfModule mod_headers.c>
  Header always append Link "</.well-known/api-catalog>; rel=\"api-catalog\""
  Header always append Link "</.well-known/agent-skills/index.json>; rel=\"agent-skills\""
  <FilesMatch "^(api-catalog|index\.json|solicitar-demo\.json)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
  <Files "api-catalog">
    Header set Content-Type "application/linkset+json"
  </Files>
</IfModule>

# ── Tipos MIME ───────────────────────────────────────────────
<IfModule mod_mime.c>
  AddType image/webp             .webp
  AddType image/avif             .avif
  AddType font/woff2             .woff2
  AddType application/manifest+json .webmanifest
</IfModule>

# ── Caché ────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html               "access plus 0 seconds"
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"
</IfModule>

# ── URLs limpias Astro static ─────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html -f
  RewriteRule ^(.+?)/?$ $1/index.html [L]
</IfModule>
