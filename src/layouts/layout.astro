---
import '../styles/global.css';

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

interface Props {
	title: string;
	description?: string;
	image?: string;
	noindex?: boolean;
}

const {
	title,
	description = 'Estratega en optimización de ventas e infraestructura para hoteles independientes: gestión, motor de reservas, asesoría y marketing digital.',
	image = '/images/engin_akyurt-bed-4416515_1920.jpg',
	noindex = false,
} = Astro.props;

const ogImageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonicalURL} />
		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex, follow" />}

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Hotel Ads" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageURL} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />

		<script type="application/ld+json" is:inline set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "ProfessionalService",
			"name": "Hotel Ads",
			"image": ogImageURL.toString(),
			"url": "https://hotelads.es",
			"telephone": "+34950131911",
			"email": "info@hotelads.es",
			"description": "Consultoría y estrategia de optimización de ventas e infraestructura para hoteles independientes.",
			"address": {
				"@type": "PostalAddress",
				"addressLocality": "Almería",
				"addressCountry": "ES"
			},
			"founder": {
				"@type": "Person",
				"name": "Antonio Soler"
			},
			"areaServed": "ES"
		})} />

		<slot name="head" />
	</head>
	<body class="bg-slate-50 text-slate-900 font-sans antialiased">
		<a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:bg-blue-700 focus:text-white focus:px-4 focus:py-2 focus:rounded-lg focus:font-semibold">
			Saltar al contenido
		</a>

		<!-- Cookie consent banner -->
		<div
			id="cookie-banner"
			class="hidden fixed inset-x-0 bottom-0 z-50 bg-slate-900/95 text-white shadow-xl backdrop-blur-sm"
		>
			<div class="max-w-6xl mx-auto px-4 py-5 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
				<div class="space-y-1 text-sm">
					<p class="font-semibold text-white">Usamos cookies analíticas solo si aceptas.</p>
					<p class="text-slate-300 leading-relaxed max-w-2xl">
						Utilizamos Google Tag Manager para medir el rendimiento del sitio.
						Acepta para activar las analíticas o recházalas para continuar sin ellas.
						<a href="/cookies" class="underline hover:text-white ml-1">Política de cookies</a>.
					</p>
				</div>
				<div class="flex flex-col gap-2 sm:flex-row sm:items-center shrink-0">
					<button
						id="cookie-accept"
						type="button"
						class="inline-flex items-center justify-center rounded-full bg-blue-600 px-5 py-2.5 text-sm font-semibold text-white shadow hover:bg-blue-500 transition-colors"
					>
						Aceptar
					</button>
					<button
						id="cookie-reject"
						type="button"
						class="inline-flex items-center justify-center rounded-full border border-slate-500 bg-slate-800 px-5 py-2.5 text-sm font-semibold text-slate-100 hover:bg-slate-700 transition-colors"
					>
						Rechazar
					</button>
				</div>
			</div>
		</div>

		<nav class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-slate-200">
			<div class="max-w-6xl mx-auto px-4 h-20 flex items-center justify-between">
				<div class="text-2xl font-bold text-blue-700">
					<a href="/">Hotel<span class="text-slate-800">Ads</span></a>
				</div>

				<div class="hidden md:flex items-center space-x-6 font-medium text-sm lg:text-base">
					<a href="/" class="hover:text-blue-700 transition-colors">Inicio</a>
					<a href="/gestion" class="hover:text-blue-700 transition-colors">Gestión</a>
					<a href="/motor" class="hover:text-blue-700 transition-colors">Motor</a>
					<a href="/asesoria" class="hover:text-blue-700 transition-colors">Asesoría</a>
					<a href="/asistente-ai" class="text-blue-600 bg-blue-50 px-3 py-1 rounded-lg border border-blue-100 hover:bg-blue-100 transition-all">
						Asistente IA
					</a>
					<a href="/contacto" class="bg-blue-700 text-white px-5 py-2 rounded-full hover:bg-blue-800 transition-all shadow-md">
						Empezar
					</a>
				</div>

				<button id="menu-button" class="md:hidden p-2 text-slate-600" aria-label="Abrir menú" aria-expanded="false" aria-controls="menu-items">
					<svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
					</svg>
				</button>
			</div>

			<div id="menu-items" class="hidden md:hidden bg-white border-b border-slate-200">
				<div class="flex flex-col p-6 space-y-4 font-semibold shadow-inner text-slate-700">
					<a href="/" class="hover:text-blue-700 border-b border-slate-50 pb-2">Inicio</a>
					<a href="/gestion" class="hover:text-blue-700 border-b border-slate-50 pb-2">Gestión</a>
					<a href="/motor" class="hover:text-blue-700 border-b border-slate-50 pb-2">Motor</a>
					<a href="/asesoria" class="hover:text-blue-700 border-b border-slate-50 pb-2">Asesoría</a>
					<a href="/asistente-ai" class="text-blue-600 border-b border-slate-50 pb-2">Asistente IA</a>
					<a href="/contacto" class="bg-blue-700 text-white px-5 py-3 rounded-xl text-center shadow-lg">Empezar</a>
				</div>
			</div>
		</nav>

		<div id="main-content"><slot /></div>

		<footer class="bg-slate-900 text-slate-400 py-16 mt-20">
			<div class="max-w-6xl mx-auto px-4">
				<div class="grid md:grid-cols-3 gap-12 border-b border-slate-800 pb-12">
					<div>
						<div class="text-white text-xl font-bold mb-4">HotelAds</div>
						<p class="text-sm">Making Things Happen. 15 años optimizando la rentabilidad del sector hotelero.</p>
					</div>
					<div>
						<p class="text-white font-semibold mb-4 uppercase tracking-wider text-sm">Servicios</p>
						<ul class="space-y-2 text-sm">
							<li><a href="/gestion" class="hover:text-blue-400">Gestión Integral</a></li>
							<li><a href="/motor" class="hover:text-blue-400">Motor de Reservas</a></li>
							<li><a href="/asesoria" class="hover:text-blue-400">Asesoría Estratégica</a></li>
							<li><a href="/asistente-ai" class="hover:text-blue-400">Asistente IA</a></li>
						</ul>
					</div>
					<div>
						<h4 class="text-white font-semibold mb-4">Contacto</h4>
						<p class="text-sm">
							¿Hablamos?
							<a href="/contacto" class="text-blue-500 font-semibold hover:text-blue-400 transition-colors underline underline-offset-4 decoration-blue-500/30">
								Agenda una cita para analizar tu hotel.
							</a>
						</p>
					</div>
				</div>
				<div class="pt-8 flex flex-col md:flex-row justify-between items-center text-xs">
					<p>© 2026 Hotel Ads | Powered by Antonio Soler</p>
					<div class="flex space-x-6 mt-4 md:mt-0">
						<a href="/aviso-legal" class="hover:text-white transition-colors">Aviso Legal</a>
						<a href="/cookies" class="hover:text-white transition-colors">Política de cookies</a>
					</div>
				</div>
			</div>
		</footer>

		<script>
			// ── Cookie consent + GTM ──────────────────────────────────────────
			const CONSENT_KEY = 'hotelads_cookie_consent';

			function getConsent(): { analytics: boolean; decided: boolean } | null {
				try {
					return JSON.parse(localStorage.getItem(CONSENT_KEY) || 'null');
				} catch {
					return null;
				}
			}

			function loadGTM() {
				const w = window as any;
				if (w._gtmLoaded) return;
				w._gtmLoaded = true;

				w.dataLayer = w.dataLayer || [];
				w.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });

				const script = document.createElement('script');
				script.async = true;
				script.src = 'https://www.googletagmanager.com/gtm.js?id=GTM-M2R3GX2';
				document.head.appendChild(script);

				// noscript fallback
				const ns = document.createElement('noscript');
				ns.innerHTML =
					'<iframe src="https://www.googletagmanager.com/ns.html?id=GTM-M2R3GX2" height="0" width="0" style="display:none;visibility:hidden"></iframe>';
				document.body.insertBefore(ns, document.body.firstChild);
			}

			function saveConsent(analytics: boolean) {
				localStorage.setItem(CONSENT_KEY, JSON.stringify({ analytics, decided: true }));
			}

			function hideBanner() {
				document.getElementById('cookie-banner')?.classList.add('hidden');
			}

			// Button listeners
			document.getElementById('cookie-accept')?.addEventListener('click', () => {
				saveConsent(true);
				hideBanner();
				loadGTM();
			});

			document.getElementById('cookie-reject')?.addEventListener('click', () => {
				saveConsent(false);
				hideBanner();
			});

			// On page load: show banner or auto-load GTM
			const consent = getConsent();
			if (!consent?.decided) {
				document.getElementById('cookie-banner')?.classList.remove('hidden');
			} else if (consent.analytics) {
				loadGTM();
			}

			// ── Mobile menu ───────────────────────────────────────────────────
			const menuButton = document.getElementById('menu-button');
			menuButton?.addEventListener('click', () => {
				const menuItems = document.getElementById('menu-items');
				const isHidden = menuItems?.classList.toggle('hidden');
				menuButton.setAttribute('aria-expanded', String(!isHidden));
			});
		</script>

		<!-- WebMCP — expone herramientas del sitio a agentes de IA -->
		<script is:inline>
			(function () {
				if (!('modelContext' in navigator)) return;
				navigator.modelContext.provideContext({
					name: 'hotelads-plataforma',
					tools: [
						{
							name: 'solicitar_demo',
							description: 'Navega a la página de contacto para solicitar una demo de HotelAds, plataforma de optimización de ventas para hoteles independientes.',
							inputSchema: { type: 'object', properties: {} },
							execute: function () {
								window.location.href = '/contacto';
								return { success: true };
							}
						},
						{
							name: 'informacion_hotelads',
							description: 'Devuelve información sobre HotelAds y sus servicios para hoteles independientes.',
							inputSchema: { type: 'object', properties: {} },
							execute: function () {
								return {
									nombre: 'HotelAds',
									descripcion: 'Plataforma de optimización de ventas e infraestructura digital para hoteles independientes',
									servicios: ['Motor de reservas directo', 'Gestión de canales OTA', 'Marketing digital hotelero', 'Revenue management'],
									contacto: 'https://hotelads.es/contacto',
									web: 'https://hotelads.es'
								};
							}
						}
					]
				});
			})();
		</script>
	</body>
</html>
