<script>
  const tz = 'Europe/Madrid';
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Hora real (Madrid) en la regla del primer viewport + qué está haciendo /staff a esa hora.
  const entries = Array.from(document.querySelectorAll<HTMLElement>('.st-entry'));
  const toMin = (hhmm: string) => { const [h, m] = hhmm.split(':').map(Number); return h * 60 + m; };
  function pintarAhora() {
    const partes = new Intl.DateTimeFormat('es-ES', { timeZone: tz, hour: '2-digit', minute: '2-digit', hour12: false }).formatToParts(new Date());
    const h = Number(partes.find((p) => p.type === 'hour')?.value ?? 0) % 24;
    const m = Number(partes.find((p) => p.type === 'minute')?.value ?? 0);
    const ahora = h * 60 + m;
    document.getElementById('st-now')?.style.setProperty('--pos', String(ahora / 1440));
    // bloque más reciente anterior a esta hora (o el último del día anterior)
    let actual = entries[entries.length - 1];
    for (const e of entries) if (toMin(e.dataset.hora!) <= ahora) actual = e;
    const hora = `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}`;
    const que = actual.querySelector('h2')?.textContent?.trim() ?? '';
    const linea = document.getElementById('st-nowline');
    if (linea && que) {
      linea.innerHTML = '';
      const b = document.createElement('b'); b.textContent = `Ahora, ${hora}. `;
      const a = document.createElement('a'); a.href = `#${actual.id}`; a.textContent = `A las ${actual.dataset.hora}: ${que}`;
      linea.append(b, a);
    }
  }
  pintarAhora();
  setInterval(pintarAhora, 60_000);

  // Reloj del carril: la hora del bloque visible.
  const reloj = document.getElementById('st-clock');
  const area = document.getElementById('st-clock-area');
  const items = new Map(Array.from(document.querySelectorAll<HTMLElement>('.st-rail-list li')).map((li) => [li.dataset.for, li]));
  function activar(e: HTMLElement) {
    if (!reloj || reloj.textContent === e.dataset.hora) return;
    reloj.textContent = e.dataset.hora ?? '';
    if (area) area.textContent = e.dataset.area ?? '';
    const mr = document.getElementById('st-mclock'); const ma = document.getElementById('st-marea');
    if (mr) mr.textContent = e.dataset.hora ?? ''; if (ma) ma.textContent = e.dataset.area ?? '';
    if (!reduce) { reloj.classList.remove('is-ticking'); void reloj.offsetWidth; reloj.classList.add('is-ticking'); }
    let pasado = true;
    for (const en of entries) {
      const li = items.get(en.id);
      if (!li) continue;
      li.classList.toggle('is-active', en === e);
      if (en === e) pasado = false;
      li.classList.toggle('is-past', pasado);
    }
  }
  const io = new IntersectionObserver((obs) => {
    for (const o of obs) if (o.isIntersecting) activar(o.target as HTMLElement);
  }, { rootMargin: '-40% 0px -55% 0px' });
  entries.forEach((e) => io.observe(e));
  if (entries[0]) activar(entries[0]);

  // Láminas que entran al hacer scroll.
  if (!reduce && 'IntersectionObserver' in window) {
    document.documentElement.classList.add('st-js');
    const plates = document.querySelectorAll('.st-entry figure');
    plates.forEach((p) => p.classList.add('st-reveal'));
    const rv = new IntersectionObserver((obs) => {
      for (const o of obs) if (o.isIntersecting) { o.target.classList.add('is-in'); rv.unobserve(o.target); }
    }, { rootMargin: '0px 0px -10% 0px' });
    plates.forEach((p) => rv.observe(p));
  }
</script>
